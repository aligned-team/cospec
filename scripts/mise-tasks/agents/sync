#!/usr/bin/env bash
# Rewrites the <!-- begin shared --> ... <!-- end shared --> block in CLAUDE.md
# and AGENTS.md from the canonical .agents/shared.md source.
# With --check, exits non-zero if either file is out of sync (no writes).
#
# Tolerant of a missing .agents/shared.md: until Track I lands that file this
# is a no-op that exits 0, so the repo verifies cleanly during bring-up.
set -euo pipefail

# Resolve the repo root from this script's own physical location rather than via
# `git rev-parse` — hk sets GIT_DIR when running hooks, which would otherwise
# make `git rev-parse --show-toplevel` return the wrong directory.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
SHARED="$REPO_ROOT/.agents/shared.md"
CHECK=false

for arg in "$@"; do
  [[ "$arg" == "--check" ]] && CHECK=true
done

if [[ ! -f "$SHARED" ]]; then
  echo "agents:sync — $SHARED not present yet; nothing to sync." >&2
  exit 0
fi

# Strip the file-level header comment (lines 1-3) — not content to embed.
TMPDIR_CUSTOM="$(mktemp -d)"
trap 'rm -rf "$TMPDIR_CUSTOM"' EXIT

SHARED_BODY_FILE="$TMPDIR_CUSTOM/shared_body"
tail -n +4 "$SHARED" > "$SHARED_BODY_FILE"

sync_file() {
  local target="$1"
  if [[ ! -f "$target" ]]; then
    echo "WARNING: $target not found, skipping" >&2
    return 0
  fi

  local new_file
  new_file="$TMPDIR_CUSTOM/new_$(basename "$target")"

  awk '/<!-- begin shared -->/{exit} {print}' "$target" > "$new_file"
  {
    printf '<!-- begin shared -->\n'
    cat "$SHARED_BODY_FILE"
    printf '<!-- end shared -->\n'
    awk 'found{print} /<!-- end shared -->/{found=1}' "$target"
  } >> "$new_file"
  mise exec -- oxfmt "$new_file" > /dev/null 2>&1 || true

  if [[ "$CHECK" == true ]]; then
    if ! diff -q "$target" "$new_file" > /dev/null 2>&1; then
      echo "DRIFT: $target is out of sync with .agents/shared.md" >&2
      echo "  Run 'mise run agents:sync' to fix." >&2
      return 1
    fi
    echo "OK: $target"
  else
    cp "$new_file" "$target"
    echo "Synced: $target"
  fi
}

EXIT=0
sync_file "$REPO_ROOT/CLAUDE.md" || EXIT=1
sync_file "$REPO_ROOT/AGENTS.md" || EXIT=1

if [[ "$CHECK" == true && "$EXIT" -eq 0 ]]; then
  echo "All shared blocks are in sync."
fi

exit "$EXIT"
