#!/usr/bin/env -S usage bash
# shellcheck shell=bash
# The jq filter literal passed to jq below uses single quotes on purpose:
# `$v` is a jq variable bound via `--arg v`, not a shell expansion. (SC2016)
# shellcheck disable=SC2016
#USAGE name "release:set-version"
#USAGE arg "<version>" help="Target npm package version (semver, e.g. 1.2.3)"
#USAGE flag "--root <root>" help="Repo root to operate on (default: the repo this script lives in). Point at a temp copy to test without mutating the working tree."

# Stamps ONE release version into every manifest that carries it:
#
#   apps/cli/package.json   .version (via jq, oxfmt-normalised) — the only
#                           manifest cospec ships to npm
#   bun.lock                the @aligned-team/cospec workspace entry's
#                           "version" (kept in sync — see below)
#
# The root package.json stays `private`/`0.0.0` and is intentionally never
# touched. Invoked by the release workflow after `cog bump --dry-run` computes
# the next semver; also runnable by hand.
#
# Idempotent: running twice with the same version yields no further change.
# Portable: uses temp-file + mv (no `sed -i`) so it behaves identically on a
# dev box and on the release runner.
#
# bun.lock note: `bun install --frozen-lockfile` was verified empirically
# (2026-07, bun 1.3.14) to accept a workspace package.json version that no
# longer matches the version recorded in bun.lock — bun does not treat that as
# lockfile drift, and neither `bun install` nor `--frozen-lockfile` refreshes
# the recorded value. So the post-bump CI installs would not break, but the
# lockfile would silently drift from package.json forever; stamping it here
# keeps the two in lockstep.

set -euo pipefail

# ---------------------------------------------------------------------------
# Parse args: one positional <version>, optional --root <dir>.
# ---------------------------------------------------------------------------
VERSION=""
ROOT=""
PREV=""
for arg in "$@"; do
  if [[ "$PREV" == "--root" ]]; then
    ROOT="$arg"
    PREV=""
    continue
  fi
  case "$arg" in
    --root)
      PREV="--root"
      ;;
    --root=*)
      ROOT="${arg#--root=}"
      ;;
    -*)
      echo "ERROR: unknown flag: $arg" >&2
      exit 2
      ;;
    *)
      if [[ -z "$VERSION" ]]; then
        VERSION="$arg"
      else
        echo "ERROR: unexpected extra argument: $arg" >&2
        exit 2
      fi
      ;;
  esac
done

if [[ -z "$VERSION" ]]; then
  echo "ERROR: missing <version> argument (e.g. 1.2.3)" >&2
  exit 2
fi

# Validate the version looks like a release semver: MAJOR.MINOR.PATCH with an
# optional -prerelease suffix. Rejects a leading 'v', ranges, and empty parts.
if [[ ! "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]]; then
  echo "ERROR: '$VERSION' is not a valid semver (expected MAJOR.MINOR.PATCH[-prerelease], no leading 'v')" >&2
  exit 2
fi

# Resolve the repo root: explicit --root wins, else the repo that contains this
# script (scripts/mise-tasks/release/set-version -> three levels up).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT_REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
if [[ -z "$ROOT" ]]; then
  ROOT="$SCRIPT_REPO_ROOT"
else
  ROOT="$(cd "$ROOT" && pwd)"
fi

require_file() {
  [[ -f "$1" ]] || { echo "ERROR: expected file not found: $1" >&2; exit 1; }
}

# Set the .version field in a JSON manifest via jq, then normalise with oxfmt
# so the result matches .oxfmtrc.json. oxfmt runs on the candidate BEFORE the
# change compare so the on-disk form is a formatter fixed point — running
# twice is a true no-op. The temp copy keeps the manifest's REAL basename
# (e.g. `package.json`) in a scratch directory: oxfmt's package.json-aware
# array formatting is keyed off the literal filename, not just the `.json`
# extension, so a mangled temp name (`.package.json.setver.$$.tmp.json`)
# silently falls back to generic JSON formatting and collapses arrays that
# oxfmt keeps multi-line for a real `package.json` — the exact drift that
# went uncaught in the v0.1.0 release bump.
set_json_version() {
  local target="$1"
  # Optional jq filter (bound with --arg v). Defaults to a bare .version stamp;
  # the main manifest passes a filter that also repins optionalDependencies.
  local filter="${2:-.version = \$v}"
  local base tmpdir tmp
  base="$(basename "$target")"
  # A sibling of $target, not $TMPDIR: keeps the later `mv` on the same
  # filesystem (atomic — no cross-device copy+delete), and the RETURN trap
  # guarantees cleanup even if jq or oxfmt fails partway through.
  tmpdir="$(mktemp -d "$(dirname "$target")/.setver.XXXXXX")"
  trap 'rm -rf "$tmpdir"' RETURN
  tmp="$tmpdir/$base"
  jq --indent 2 --arg v "$VERSION" "$filter" "$target" > "$tmp"
  # Normalise with oxfmt when available; let a real oxfmt failure abort the run
  # (the command -v guard already covers the not-installed case) so we never
  # commit partially-normalised JSON or mask a broken toolchain.
  if command -v oxfmt >/dev/null 2>&1; then
    # -c pins THIS SCRIPT's own repo config explicitly: $ROOT may be a
    # throwaway copy of just a few manifests with no .oxfmtrc.json of its own
    # (e.g. under test via --root), in which case oxfmt's own upward config
    # search from $tmp would find nothing.
    oxfmt -c "$SCRIPT_REPO_ROOT/.oxfmtrc.json" --write "$tmp" >/dev/null 2>&1
  fi
  if cmp -s "$tmp" "$target"; then
    echo "  unchanged: ${target#"$ROOT"/}"
  else
    mv "$tmp" "$target"
    echo "  updated:   ${target#"$ROOT"/}"
  fi
}

# Replace a file's contents from stdin, only when they actually changed, and
# never leave a half-written file behind (write to a temp sibling, then mv).
write_if_changed() {
  local target="$1"
  local tmp
  tmp="$(mktemp "$target.XXXXXX.tmp")"
  cat >"$tmp"
  if cmp -s "$tmp" "$target"; then
    rm -f "$tmp"
    echo "  unchanged: ${target#"$ROOT"/}"
  else
    mv "$tmp" "$target"
    echo "  updated:   ${target#"$ROOT"/}"
  fi
}

# --- apps/cli/package.json: .version + optionalDependencies pins -------------
# The main package pins each per-platform binary package at the EXACT same
# version (they are cut from the same commit), so the stamp repins every
# optionalDependencies entry alongside .version.
CLI_PACKAGE="$ROOT/apps/cli/package.json"
require_file "$CLI_PACKAGE"
set_json_version "$CLI_PACKAGE" \
  '.version = $v | if .optionalDependencies then .optionalDependencies |= with_entries(.value = $v) else . end'

# --- apps/cli/npm/<platform>/package.json .version --------------------------
# One package per platform — Linux split by libc (gnu/musl; bun's builds are
# not cross-libc portable), plus darwin and windows — each carrying only the
# compiled binary. Fail loudly if the set of platform dirs ever drifts from
# what the main manifest pins.
for platform in linux-x64-gnu linux-x64-musl linux-arm64-gnu linux-arm64-musl \
  darwin-x64 darwin-arm64 win32-x64; do
  PLATFORM_PACKAGE="$ROOT/apps/cli/npm/$platform/package.json"
  require_file "$PLATFORM_PACKAGE"
  set_json_version "$PLATFORM_PACKAGE"
done

# --- bun.lock: the @aligned-team/cospec workspace entry's "version" ----------
# bun.lock is JSON-with-trailing-commas, so jq can't parse it. The workspace
# entry's "version" line directly follows its "name" line; scope the rewrite
# to the first "version" after that exact name and reset the flag once done so
# no other package's version can move. Fail loudly if the entry is missing so
# a renamed package can't silently no-op the stamp.
LOCK="$ROOT/bun.lock"
require_file "$LOCK"
if ! grep -q '"name": "@aligned-team/cospec"' "$LOCK"; then
  echo "ERROR: no @aligned-team/cospec workspace entry found in $LOCK" >&2
  exit 1
fi
# The rewrite is scoped to the workspace-entry block (from the cospec "name"
# line down to the top-level "packages": section) so no unrelated package's
# version moves: the block's first "version" (its own) plus every
# optionalDependencies pin ("@aligned-team/cospec-<platform>": "x.y.z") are
# repinned to the same version the main manifest carries.
awk -v ver="$VERSION" '
  /"name": "@aligned-team\/cospec"/ { inws = 1 }
  /^[[:space:]]*"packages": {/ { inws = 0 }
  inws && !versioned && /^[[:space:]]*"version": / {
    match($0, /^[[:space:]]*/)
    indent = substr($0, 1, RLENGTH)
    $0 = indent "\"version\": \"" ver "\","
    versioned = 1
  }
  inws && /^[[:space:]]*"@aligned-team\/cospec-[a-z0-9-]+": "/ {
    match($0, /^[[:space:]]*/)
    indent = substr($0, 1, RLENGTH)
    match($0, /"@aligned-team\/cospec-[a-z0-9-]+"/)
    key = substr($0, RSTART, RLENGTH)
    $0 = indent key ": \"" ver "\","
  }
  { print }
' "$LOCK" | write_if_changed "$LOCK"

echo "cospec version set to $VERSION"
