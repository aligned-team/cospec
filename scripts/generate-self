#!/usr/bin/env bash
# Run `cospec update` over this repo's own managed files as if on a machine with nothing in its
# home directory. `update` honours the `delivery` key of the machine-global OpenSpec config, so on
# a host whose config says `delivery: commands` (or `skills`) `generate` would delete the committed
# skills (or commands) and `generate:check` would fail; its `profile`/`workflows` keys only pick
# what a row gets by default and never drop an installed workflow, so they do not move the output.
# `update` also reads and rewrites the home-scoped skills root of the rows it maintains
# (`~/.minimax/skills`), so a host holding an older cospec's skills there reports drift and has
# them rewritten. `CODEX_HOME` is set too although `update` never reads it: the script forwards any
# subcommand, and `init` sweeps `$CODEX_HOME/prompts` for legacy prompts. One empty temporary
# directory stands in for HOME and every config/data/state/cache root, which keeps `generate` and
# `generate:check` host-independent and writes nothing outside this repo.
set -euo pipefail

empty_home="$(mktemp -d "${TMPDIR:-/tmp}/cospec-generate-home.XXXXXX")"
trap 'rm -rf "$empty_home"' EXIT

HOME="$empty_home" \
  USERPROFILE="$empty_home" \
  CODEX_HOME="$empty_home" \
  XDG_CONFIG_HOME="$empty_home" \
  XDG_DATA_HOME="$empty_home" \
  XDG_STATE_HOME="$empty_home" \
  XDG_CACHE_HOME="$empty_home" \
  bun run apps/cli/src/index.ts -- "$@"
