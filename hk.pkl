amends "package://github.com/jdx/hk/releases/download/v1.48.0/hk@1.48.0#/Config.pkl"

// NOTE: Builtins import omitted — pklr (experimental backend, HK_PKL_BACKEND=pklr)
// has deserialization issues with Builtins._type fields. All steps are defined
// explicitly below, which is equivalent and more portable.
//
// NOTE: Multiline check strings (#"""..."""#) inside commit-msg steps cause pklr
// deserialization failures. The commit-msg check delegates to a script in
// scripts/hooks/ for pklr compatibility.

local tsGlobs = List("**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mts", "**/*.cts")
// `bun fmt` (Bun's built-in formatter, configured with per-type overrides in
// bunfig.toml's `[fmt]`) also formats JSON, JSONC, and Markdown — oxlint has no
// support for either, so oxlint stays on tsGlobs alone.
local fmtGlobs = tsGlobs + List("**/*.json", "**/*.jsonc", "**/*.md", "**/*.mdx")
local tomlGlobs = List("**/*.toml")
local shellGlobs = List("**/*.sh", "**/*.bash")
local ciGlobs = List(".github/workflows/**/*.yml", ".github/workflows/**/*.yaml")

// Hand-authored canon: gated by generate:check below (editing it without
// regenerating is drift), but it's ordinary source, so it stays in bun fmt's
// glob — only the generated output below is excluded from bun fmt.
local canonGlobs = List("apps/cli/src/canon/**")
// Generated output: produced by cospec's own generator, which is itself the
// formatter's fixed point (checked by generate:check below) — bun fmt must not
// fight that.
local generatedOutputGlobs = List(
  "openspec/schemas/**",
  ".claude/**",
  // Only .agents/skills/** is cospec-generated — .agents/shared.md is the
  // hand-authored source for the shared CLAUDE.md/AGENTS.md block (see
  // agentGlobs below) and must stay in bun fmt's check.
  ".agents/skills/**",
  ".codex/**",
  ".opencode/**"
)
local generatedGlobs = canonGlobs + generatedOutputGlobs

// Files `[fmt] ignorePatterns` excludes that are NOT under generatedOutputGlobs: the
// vendored openspec bundle and its license notices (both built by
// `mise run vendor:openspec` and drift-gated by `vendor:openspec:check`), and
// the bench `style` fixture that is deliberately seeded mis-formatted. bun fmt
// exits non-zero ("Expected at least one target file") when a batch contains
// only ignored files, so — as with oxlint and `**/*.d.ts` below — they must be
// kept out of the hook's file list entirely, not merely ignored by bun fmt.
local formatterIgnoredGlobs = List(
  "apps/cli/src/vendor/**",
  "apps/cli/THIRD-PARTY-LICENSES.md",
  "packages/bench/scenarios/fixtures/style/src/format.ts",
  // harness-adapter-table (R8): committed raw golden files (see bunfig.toml's
  // matching `[fmt] ignorePatterns` entry) — renderHarnessFiles's own output is
  // their formatting authority, not bun fmt.
  "**/__golden__/**"
)

local agentGlobs = List(".agents/shared.md", "CLAUDE.md", "AGENTS.md")

local linters = new Mapping<String, Step> {
  ["bun-fmt"] {
    glob = fmtGlobs
    exclude = generatedOutputGlobs + formatterIgnoredGlobs
    check = "bun fmt --check {{files}}"
    fix = "bun fmt {{files}}"
    batch = true
    prefix = "mise exec --"
  }
  ["oxlint"] {
    glob = tsGlobs
    // .oxlintrc.json ignores **/*.d.ts; oxlint exits non-zero ("No files found
    // to lint") when a batch contains only ignored files, so keep them out of
    // the hook's file list entirely.
    exclude = List("**/*.d.ts")
    check = "oxlint {{files}}"
    fix = "oxlint --fix {{files}}"
    batch = true
    prefix = "mise exec --"
  }
  ["taplo"] {
    glob = tomlGlobs
    check = "taplo format --check {{files}}"
    fix = "taplo format {{files}}"
    batch = true
    prefix = "mise exec --"
  }
  ["shellcheck"] {
    glob = shellGlobs
    check = "shellcheck -x {{files}}"
    batch = true
    prefix = "mise exec --"
  }
  ["actionlint"] {
    glob = ciGlobs
    check = "actionlint {{files}}"
    batch = true
    prefix = "mise exec --"
  }
}

local agentSteps = new Mapping<String, Step> {
  ["agents:check"] {
    glob = agentGlobs
    check = "mise run agents:check"
  }
}

// Drift gate: hand-edits to any managed file fail the commit. This is the
// self-repo half of `cospec update --check` (a.k.a. `generate:check`).
local generateSteps = new Mapping<String, Step> {
  ["generate:check"] {
    glob = generatedGlobs
    check = "mise run generate:check"
  }
}

// cospec validation + blocker reconciliation over this repo's own openspec tree.
local cospecSteps = new Mapping<String, Step> {
  ["cospec-validate"] {
    glob = List("openspec/**")
    exclude = List("openspec/changes/archive/**")
    check = "mise run cospec -- validate --all --strict"
    exclusive = true
  }
  ["cospec-sync-blockers"] {
    glob = List("openspec/changes/**")
    exclude = List("openspec/changes/archive/**")
    check = "mise run cospec -- sync-blockers --check"
    fix = "mise run cospec -- sync-blockers"
  }
}

// Type errors cross files, so any staged or pushed TS file (or tsconfig) type-checks every
// workspace with `bun check` — about a second.
local typecheckSteps = new Mapping<String, Step> {
  ["typecheck"] {
    glob = tsGlobs + List("**/tsconfig*.json")
    check = "mise run typecheck"
    exclusive = true
  }
}

// Tests: only what the change reaches (apps/cli/test/fixtures/test-scope.ts): the test files whose
// import graph reaches a changed file, or a whole suite when a change sits outside the graph. A
// commit runs the unit tests its staged changes reach. A push runs the unit, integration and
// contract tests its changes reach: for each pushed ref, its diff from the sha the remote has (a
// new branch: from the newest commits the remote already has). git hands the hook the remote and
// the refs; hk passes them on as `hook_args` and `hook_stdin` (its `{{files}}` drops deletions).
// A change outside the graph — canon, the CLI's boot path — runs a whole suite: the contract
// suite takes about 8 minutes locally. PR CI runs the same selection against the PR's base; main
// and the merge queue run every suite whole.
local commitTestSteps = new Mapping<String, Step> {
  ["test"] {
    check = "mise run test:changed -- --staged unit"
    exclusive = true
  }
}
local pushTestSteps = new Mapping<String, Step> {
  ["test"] {
    stdin = "{{ hook_args }}\n{{ hook_stdin }}"
    check = "bun apps/cli/test/fixtures/run-changed.ts --push unit integration contract"
    prefix = "mise exec --"
    exclusive = true
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "patch-file"
    steps = new {
      ...linters
      ...agentSteps
      ...generateSteps
      ...cospecSteps
      ...typecheckSteps
      ...commitTestSteps
    }
  }
  ["pre-push"] {
    steps = new {
      ...linters
      ...typecheckSteps
      ...pushTestSteps
    }
  }
  ["commit-msg"] {
    steps {
      ["conventional"] {
        check = #"bash scripts/hooks/check-commit-msg "{{commit_msg_file}}""#
      }
    }
  }
}
