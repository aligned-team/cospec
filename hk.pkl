amends "package://github.com/jdx/hk/releases/download/v1.45.0/hk@1.45.0#/Config.pkl"

hooks {
    ["commit-msg"] {
        steps {
            ["commitlint"] {
                check = "mise run commitlint:edit {{commit_msg_file}}"
                exclusive = true
            }
        }
    }
    ["pre-commit"] {
        steps {
            ["openspec-validate-changed"] {
                check = "mise run openspec:validate-changed"
                exclusive = true
            }
        }
    }
    ["pre-push"] {
        steps {
            ["openspec-validate-all"] {
                check = "mise run openspec:validate-all"
                exclusive = true
            }
        }
    }
}
