amends "package://github.com/jdx/hk/releases/download/v1.48.0/hk@1.48.0#/Config.pkl"

// NOTE: Builtins import omitted — pklr (experimental backend, HK_PKL_BACKEND=pklr)
// has deserialization issues with Builtins._type fields. All steps are defined
// explicitly below, which is equivalent and more portable.
//
// NOTE: Multiline check strings (#"""..."""#) inside commit-msg steps cause pklr
// deserialization failures. The commit-msg check delegates to a script in
// scripts/hooks/ for pklr compatibility.

local tsGlobs = List("**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mts", "**/*.cts")
// oxfmt (0.56.0, per `.oxfmtrc.json`'s per-type overrides) also formats JSON,
// JSONC, and Markdown — oxlint has no support for either, so oxlint stays on
// tsGlobs alone.
local oxfmtGlobs = tsGlobs + List("**/*.json", "**/*.jsonc", "**/*.md", "**/*.mdx")
local tomlGlobs = List("**/*.toml")
local shellGlobs = List("**/*.sh", "**/*.bash")
local ciGlobs = List(".github/workflows/**/*.yml", ".github/workflows/**/*.yaml")

// Hand-authored canon: gated by generate:check below (editing it without
// regenerating is drift), but it's ordinary source, so it stays in oxfmt's
// glob — only the generated output below is excluded from oxfmt.
local canonGlobs = List("apps/cli/src/canon/**")
// Generated output: produced by cospec's own generator, which is itself the
// formatter's fixed point (checked by generate:check below) — oxfmt must not
// fight that.
local generatedOutputGlobs = List(
  "openspec/schemas/**",
  ".claude/**",
  ".codex/**",
  ".opencode/**"
)
local generatedGlobs = canonGlobs + generatedOutputGlobs

// Files `.oxfmtignore` excludes that are NOT under generatedOutputGlobs: the
// vendored openspec bundle and its license notices (both built by
// `mise run vendor:openspec` and drift-gated by `vendor:openspec:check`), and
// the bench `style` fixture that is deliberately seeded mis-formatted. oxfmt
// exits non-zero ("Expected at least one target file") when a batch contains
// only ignored files, so — as with oxlint and `**/*.d.ts` below — they must be
// kept out of the hook's file list entirely, not merely ignored by oxfmt.
local formatterIgnoredGlobs = List(
  "apps/cli/src/vendor/**",
  "apps/cli/THIRD-PARTY-LICENSES.md",
  "packages/bench/scenarios/fixtures/style/src/format.ts"
)

local agentGlobs = List(".agents/shared.md", "CLAUDE.md", "AGENTS.md")

local linters = new Mapping<String, Step> {
  ["oxfmt"] {
    glob = oxfmtGlobs
    exclude = generatedOutputGlobs + formatterIgnoredGlobs
    check = "oxfmt --check {{files}}"
    fix = "oxfmt {{files}}"
    batch = true
    prefix = "mise exec --"
  }
  ["oxlint"] {
    glob = tsGlobs
    // .oxlintrc.json ignores **/*.d.ts; oxlint exits non-zero ("No files found
    // to lint") when a batch contains only ignored files, so keep them out of
    // the hook's file list entirely.
    exclude = List("**/*.d.ts")
    check = "oxlint {{files}}"
    fix = "oxlint --fix {{files}}"
    batch = true
    prefix = "mise exec --"
  }
  ["taplo"] {
    glob = tomlGlobs
    check = "taplo format --check {{files}}"
    fix = "taplo format {{files}}"
    batch = true
    prefix = "mise exec --"
  }
  ["shellcheck"] {
    glob = shellGlobs
    check = "shellcheck -x {{files}}"
    batch = true
    prefix = "mise exec --"
  }
  ["actionlint"] {
    glob = ciGlobs
    check = "actionlint {{files}}"
    batch = true
    prefix = "mise exec --"
  }
}

local agentSteps = new Mapping<String, Step> {
  ["agents:check"] {
    glob = agentGlobs
    check = "mise run agents:check"
  }
}

// Drift gate: hand-edits to any managed file fail the commit. This is the
// self-repo half of `cospec update --check` (a.k.a. `generate:check`).
local generateSteps = new Mapping<String, Step> {
  ["generate:check"] {
    glob = generatedGlobs
    check = "mise run generate:check"
  }
}

// cospec validation + blocker reconciliation over this repo's own openspec tree.
local cospecSteps = new Mapping<String, Step> {
  ["cospec-validate"] {
    glob = List("openspec/**")
    exclude = List("openspec/changes/archive/**")
    check = "mise run cospec -- validate --all --strict"
    exclusive = true
  }
  ["cospec-sync-blockers"] {
    glob = List("openspec/changes/**")
    exclude = List("openspec/changes/archive/**")
    check = "mise run cospec -- sync-blockers --check"
    fix = "mise run cospec -- sync-blockers"
  }
}

// Slow profile (HK_PROFILE=slow) — layered on at push time by the pre-push-gate
// wrapper when pushing to main; feature-branch pushes run only the linters.
local slowSteps = new Mapping<String, Step> {
  ["typecheck"] {
    glob = tsGlobs
    check = "mise run typecheck"
    profiles = List("slow")
    exclusive = true
  }
  ["test"] {
    check = "mise run test"
    profiles = List("slow")
    exclusive = true
  }
  ["test:contract"] {
    check = "mise run test:contract"
    profiles = List("slow")
    exclusive = true
  }
  ["test:integration"] {
    check = "mise run test:integration"
    profiles = List("slow")
    exclusive = true
  }
  ["build"] {
    check = "mise run build"
    profiles = List("slow")
    exclusive = true
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "patch-file"
    steps = new {
      ...linters
      ...agentSteps
      ...generateSteps
      ...cospecSteps
    }
  }
  ["pre-push"] {
    steps = new {
      ...linters
      ...slowSteps
    }
  }
  ["commit-msg"] {
    steps {
      ["conventional"] {
        check = #"bash scripts/hooks/check-commit-msg "{{commit_msg_file}}""#
      }
    }
  }
}
