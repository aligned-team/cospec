  },
  "devDependencies": {
    "bun-types": "1.3.14",
    "yaml": "2.9.0"
  },
  "optionalDependencies": {
    "@aligned-team/cospec-darwin-arm64": "0.3.0",
    "@aligned-team/cospec-darwin-x64": "0.3.0",
    "@aligned-team/cospec-linux-arm64-gnu": "0.3.0",
    "@aligned-team/cospec-linux-arm64-musl": "0.3.0",
    "@aligned-team/cospec-linux-x64-gnu": "0.3.0",
    "@aligned-team/cospec-linux-x64-musl": "0.3.0",
    "@aligned-team/cospec-win32-x64": "0.3.0"
  },
  "engines": {
    "node": ">=18"
  }
