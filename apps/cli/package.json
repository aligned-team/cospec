{
  "name": "@aligned-team/cospec",
  "version": "0.3.0",
  "description": "OpenSpec change management, sized to your commit type. feat gets the full treatment; ci takes two minutes.",
  "keywords": [
    "ai-agents",
    "changelog",
    "cli",
    "conventional-commits",
    "openspec",
    "spec-driven"
  ],
  "homepage": "https://github.com/aligned-team/cospec",
  "bugs": "https://github.com/aligned-team/cospec/issues",
  "license": "MIT",
  "author": {
    "name": "Aligned",
    "email": "engineering@aligned.team"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aligned-team/cospec.git",
    "directory": "apps/cli"
  },
  "bin": {
    "cospec": "./bin/cospec.js"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-LICENSES.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
